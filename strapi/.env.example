HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Public URL of this Strapi instance (used for absolute media URLs in production)
PUBLIC_URL=
# Strapi MCP server at POST /mcp (https://docs.strapi.io/cms/features/strapi-mcp-server)
MCP_ENABLED=true

# Seed script (npm run seed) — Strapi must be running
STRAPI_URL=http://localhost:1337
STRAPI_ADMIN_EMAIL=
STRAPI_ADMIN_PASSWORD=
# Admin token used by the MCP server (Settings → Admin Tokens)
STRAPI_MCP_TOKEN=
