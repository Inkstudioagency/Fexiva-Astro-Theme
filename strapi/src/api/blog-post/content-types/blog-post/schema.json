{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post",
    "description": "Articles shown on the Blog, Home and About pages."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "maxLength": 300
    },
    "mainImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Fintech",
        "Product",
        "Security",
        "Company"
      ],
      "required": true,
      "default": "Fintech"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "publishedDate": {
      "type": "date",
      "required": true
    },
    "readTime": {
      "type": "integer",
      "min": 1
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "blogPosts"
    },
    "body": {
      "type": "blocks"
    },
    "articleImages": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "bodyContinued": {
      "type": "blocks"
    }
  }
}
