{
  "kind": "collectionType",
  "collectionName": "integrations",
  "info": {
    "singularName": "integration",
    "pluralName": "integrations",
    "displayName": "Integration",
    "description": "Apps listed on the Integrations page."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "maxLength": 300
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Accounting",
        "Analytics",
        "Banking",
        "CRM",
        "Payments",
        "Payroll"
      ]
    },
    "body": {
      "type": "blocks"
    },
    "articleImages": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "bodyContinued": {
      "type": "blocks"
    }
  }
}
