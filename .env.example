# Strapi CMS base URL (no trailing slash)
# Leave empty to use the bundled sample content (src/data/sample-content.json)
STRAPI_URL=
# Read-only Strapi API token (Settings → API Tokens → Read-only). Server-side only, never sent to the browser.
STRAPI_API_TOKEN=
# Optional: URL that receives form submissions (Formspree, Basin, your own API...). Empty = demo mode.
PUBLIC_FORM_ENDPOINT=
# Production URL, used for canonical URLs, Open Graph images and the sitemap
SITE_URL=https://example.com
