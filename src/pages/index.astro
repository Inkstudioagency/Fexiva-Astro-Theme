import Hero from '../components/sections/home/Hero.astro';
import Partners from '../components/sections/home/Partners.astro';
import About from '../components/sections/home/About.astro';
import Benefits from '../components/sections/home/Benefits.astro';
import Feature from '../components/sections/home/Feature.astro';
import Integration from '../components/sections/home/Integration.astro';
import Pricing from '../components/sections/home/Pricing.astro';
import Testimonials from '../components/sections/home/Testimonials.astro';
