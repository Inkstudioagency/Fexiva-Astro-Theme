---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
}

const { eyebrow, title, text } = Astro.props;
---

<section class="section_utility-hero"><div class="w-layout-blockcontainer container-main page-hero-content w-container"><div class="section-header"><div page-load-1="" class="section-eyebrow"><div class="section-eyebrow-dot"></div><div class="section-eyebrow-text">{eyebrow}</div></div><h1 hero-title="" class="heading-style-1 is-page-hero">{title}</h1><p page-load-3="" class="text-size-large text-color-white is-hero-text">{text}</p></div></div></section>
