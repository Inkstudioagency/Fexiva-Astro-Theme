---
import { site } from '../../config/site';

interface Props {
  /** Page title without the site suffix. Omit on the home page. */
  title?: string;
  /** Use the title as-is without appending the site suffix (CMS detail pages). */
  rawTitle?: boolean;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, rawTitle = false, description = site.description, image = site.ogImage, noindex = false } = Astro.props;

const fullTitle = !title ? site.titleSuffix : rawTitle ? title : `${title} | ${site.titleSuffix}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).href;
---

<title>{fullTitle}</title>
<meta content={description} name="description" />
<meta content={fullTitle} property="og:title" />
<meta content={description} property="og:description" />
<meta content={ogImage} property="og:image" />
<meta content={fullTitle} name="twitter:title" />
<meta content={description} name="twitter:description" />
<meta content={ogImage} name="twitter:image" />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical.href} />
<meta content="summary_large_image" name="twitter:card" />
{noindex && <meta content="noindex" name="robots" />}
<link rel="canonical" href={canonical.href} />
