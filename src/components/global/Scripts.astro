---
// Runtime scripts, loaded in the same order as the original Webflow export.
// webflow.js drives navigation, tabs, forms, Lottie and the IX3 (GSAP) interactions,
// so it and its dependencies are served as classic scripts from /public.
---

<script is:inline src="/js/vendor/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
<script is:inline src="/js/webflow.js"></script>
<script is:inline src="/js/vendor/gsap.min.js"></script>
<script is:inline src="/js/vendor/ScrollTrigger.min.js"></script>
<script is:inline src="/js/vendor/SplitText.min.js"></script>
<script is:inline src="/js/vendor/Observer.min.js"></script>
<script is:inline>gsap.registerPlugin(ScrollTrigger,SplitText,Observer);</script>
<script is:inline src="/js/vendor/lenis.min.js"></script>
<script is:inline>
  // Smooth scrolling
  const lenis = new Lenis({
    smoothWheel: true,
    lerp: 0.1,
    wheelMultiplier: 1,
    infinite: false
  });
  function raf(time) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }
  requestAnimationFrame(raf);
</script>
<script is:inline>
  // Counter animation: counts every [data-counter] element up from zero when it scrolls into view.
  window.Webflow ||= [];
  window.Webflow.push(() => {
    document.querySelectorAll("[data-counter]").forEach((counter) => {
      const textEl = counter.firstElementChild || counter;
      const original = textEl.textContent.trim();
      const match = original.match(/^([^0-9.-]*)([0-9.,-]+)(.*)$/);
      if (!match) return;
      const prefix = match[1];
      const number = match[2].replace(/,/g, "");
      const suffix = match[3];
      const target = parseFloat(number);
      if (Number.isNaN(target)) return;
      const hasDecimal = number.includes(".");
      const hasComma = original.includes(",");
      const value = { current: 0 };
      gsap.fromTo(
        value,
        { current: 0 },
        {
          current: target,
          duration: 1.8,
          ease: "power2.out",
          scrollTrigger: {
            trigger: counter,
            start: "top 88%",
            once: true
          },
          onUpdate: () => {
            let formattedValue = hasDecimal
              ? value.current.toFixed(1)
              : Math.floor(value.current);
            if (hasComma && !hasDecimal) {
              formattedValue = Number(formattedValue).toLocaleString();
            }
            textEl.textContent =
              prefix + formattedValue + suffix;
          }
        }
      );
    });
  });
</script>
